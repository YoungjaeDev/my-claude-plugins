node_modules/
dist/
*.log
.DS_Store
.claude/state/
.serena/
.sisyphus/

# Secrets — skills read API keys from a .env (never commit keys)
.env
.env.local

# Ephemeral llm-wiki Stop-capture staging (consumed by the next session's drain hook).
# Three roots mirror the wiki resolution order .llmwiki -> .claude -> .codex; the hooks
# write to dirname(wiki_root)/.staging, so a legacy root yields .claude/.staging or .codex/.staging.
.llmwiki/.staging/
.claude/.staging/
.codex/.staging/

# Python bytecode + test cache (regenerated on every run)
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Windows reserved names (prevent accidental creation)
nul
NUL
.tmp/

# `remember` skill session-state + backup-daemon artifacts — machine-local scratch
# that a local auto-backup process commits; never part of the marketplace source.
.remember/
.git-backup-remote
.last-git-backup-ts

# personal profile (local only)
USER.md
