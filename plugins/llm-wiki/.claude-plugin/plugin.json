{
  "name": "llm-wiki",
  "version": "1.0.0",
  "description": "Karpathy LLM-Wiki 3-layer system: 5 skills (query/ingest/lint/bootstrap/post-merge-wiki) + state-tracker + 2 soft-hint hooks (stale check, post-commit hint). Universal — works in any repo with .claude/wiki/.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/wiki_stale_check.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/wiki_post_commit_hint.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
